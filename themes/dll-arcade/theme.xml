<?xml version="1.0"?>
<!--
  DLL ARCADE - Skate Town 1984: EmulationStation theme for the xarcade cabinet (1920x1080).
  Same look as the RinkMaster app and the arcade2 Attract-Mode "rink" layout: navy-to-maroon backdrop with spotlight beams and
  carpet confetti, the red/amber/teal stripe band, red glowing frames, Bebas Neue and Bungee type.
  Art is generated by scripts/make-es-theme-assets.py in the RinkMaster repo. Palette: red E5242B, amber FFB042, teal 2EC4B6,
  lavender 9682BE, cream FFC48C.
-->
<theme>
	<formatVersion>4</formatVersion>

	<!-- ===== system carousel ===== -->
	<view name="system">
		<image name="background" extra="true">
			<path>./art/bg.png</path>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>

		<image name="logo-banner" extra="true">
			<path>./art/logo.png</path>
			<pos>0.5 0.01</pos>
			<origin>0.5 0</origin>
			<maxSize>0.42 0.3</maxSize>
			<zIndex>10</zIndex>
		</image>

		<carousel name="systemcarousel">
			<type>horizontal</type>
			<pos>0 0.36</pos>
			<size>1 0.36</size>
			<origin>0 0</origin>
			<color>00000000</color>
			<logoScale>1.35</logoScale>
			<logoRotation>0</logoRotation>
			<logoSize>0.30 0.30</logoSize>
			<maxLogoCount>3</maxLogoCount>
			<zIndex>50</zIndex>
		</carousel>

		<text name="logoText">
			<fontPath>./art/Bungee-Regular.ttf</fontPath>
			<fontSize>0.075</fontSize>
			<color>FFB042</color>
			<forceUppercase>true</forceUppercase>
		</text>

		<text name="systemInfo">
			<pos>0 0.77</pos>
			<size>1 0.06</size>
			<origin>0 0</origin>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.05</fontSize>
			<alignment>center</alignment>
			<color>2EC4B6</color>
			<forceUppercase>true</forceUppercase>
			<zIndex>50</zIndex>
		</text>

		<helpsystem name="help">
			<pos>0.5 0.975</pos>
			<origin>0.5 1</origin>
			<textColor>FFC48C</textColor>
			<iconColor>FFB042</iconColor>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.04</fontSize>
		</helpsystem>
	</view>

	<!-- ===== game lists (all three styles) ===== -->
	<view name="basic, detailed, video">
		<image name="background" extra="true">
			<path>./art/bg.png</path>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>

		<image name="logo-banner" extra="true">
			<path>./art/logo.png</path>
			<pos>0.02 0.01</pos>
			<origin>0 0</origin>
			<maxSize>0.34 0.24</maxSize>
			<zIndex>10</zIndex>
		</image>

		<text name="logoText">
			<pos>0.5104 0.075</pos>
			<size>0.4604 0.08</size>
			<origin>0 0</origin>
			<fontPath>./art/Bungee-Regular.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<alignment>center</alignment>
			<color>FFB042</color>
			<forceUppercase>true</forceUppercase>
			<zIndex>5</zIndex>
		</text>

		<textlist name="gamelist">
			<pos>0.03 0.245</pos>
			<size>0.45 0.63</size>
			<origin>0 0</origin>
			<selectorImagePath>./art/selector.png</selectorImagePath>
			<selectorImageTile>false</selectorImageTile>
			<selectorColor>FFFFFFFF</selectorColor>
			<selectorHeight>0.048</selectorHeight>
			<selectorOffsetY>0.008</selectorOffsetY>
			<selectedColor>FFFFFF</selectedColor>
			<primaryColor>FFC48C</primaryColor>
			<secondaryColor>9682BE</secondaryColor>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.05</fontSize>
			<alignment>center</alignment>
			<horizontalMargin>0.012</horizontalMargin>
			<lineSpacing>1.0</lineSpacing>
			<forceUppercase>true</forceUppercase>
			<zIndex>20</zIndex>
		</textlist>

		<text name="gamelistInfo">
			<pos>0.03 0.885</pos>
			<size>0.45 0.04</size>
			<origin>0 0</origin>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.032</fontSize>
			<alignment>left</alignment>
			<color>9682BE</color>
			<zIndex>20</zIndex>
		</text>

		<helpsystem name="help">
			<pos>0.5 0.975</pos>
			<origin>0.5 1</origin>
			<textColor>FFC48C</textColor>
			<iconColor>FFB042</iconColor>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.04</fontSize>
		</helpsystem>
	</view>

	<!-- ===== detailed / video: media frame and facts on the right ===== -->
	<view name="detailed, video">
		<image name="md_marquee">
			<pos>0.7708 0.19</pos>
			<origin>0.5 1</origin>
			<maxSize>0.46 0.15</maxSize>
			<zIndex>20</zIndex>
		</image>

		<image name="md_image">
			<pos>0.7708 0.42</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.43 0.38</maxSize>
			<zIndex>20</zIndex>
		</image>

		<image name="frame" extra="true">
			<path>./art/frame.png</path>
			<pos>0.7708 0.42</pos>
			<origin>0.5 0.5</origin>
			<size>0.4979 0.5333</size>
			<zIndex>30</zIndex>
		</image>

		<datetime name="md_releasedate">
			<pos>0.5104 0.685</pos>
			<size>0.1 0.05</size>
			<origin>0 0</origin>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.042</fontSize>
			<color>FFB042</color>
			<format>%Y</format>
			<zIndex>20</zIndex>
		</datetime>

		<text name="md_developer">
			<pos>0.6 0.685</pos>
			<size>0.22 0.05</size>
			<origin>0 0</origin>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.042</fontSize>
			<color>2EC4B6</color>
			<forceUppercase>true</forceUppercase>
			<zIndex>20</zIndex>
		</text>

		<text name="md_genre">
			<pos>0.83 0.685</pos>
			<size>0.14 0.05</size>
			<origin>0 0</origin>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.042</fontSize>
			<color>9682BE</color>
			<forceUppercase>true</forceUppercase>
			<alignment>right</alignment>
			<zIndex>20</zIndex>
		</text>

		<text name="md_description">
			<pos>0.5104 0.745</pos>
			<size>0.4604 0.11</size>
			<origin>0 0</origin>
			<fontPath>./art/BebasNeue-Regular.ttf</fontPath>
			<fontSize>0.03</fontSize>
			<color>FFE6D2</color>
			<alignment>left</alignment>
			<zIndex>20</zIndex>
		</text>

		<!-- the facts above are laid out by hand, so the stock labels and the rest stay hidden -->
		<text name="md_lbl_rating"><visible>false</visible></text>
		<text name="md_lbl_releasedate"><visible>false</visible></text>
		<text name="md_lbl_developer"><visible>false</visible></text>
		<text name="md_lbl_publisher"><visible>false</visible></text>
		<text name="md_lbl_genre"><visible>false</visible></text>
		<text name="md_lbl_players"><visible>false</visible></text>
		<text name="md_lbl_lastplayed"><visible>false</visible></text>
		<text name="md_lbl_playcount"><visible>false</visible></text>
		<rating name="md_rating"><visible>false</visible></rating>
		<text name="md_publisher"><visible>false</visible></text>
		<text name="md_players"><visible>false</visible></text>
		<datetime name="md_lastplayed"><visible>false</visible></datetime>
		<text name="md_playcount"><visible>false</visible></text>
		<text name="md_name"><visible>false</visible></text>
	</view>

	<!-- the video view plays the snap inside the same frame -->
	<view name="video">
		<video name="md_video">
			<pos>0.7708 0.42</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.43 0.38</maxSize>
			<delay>1.2</delay>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>true</showSnapshotDelay>
			<zIndex>25</zIndex>
		</video>
	</view>

	<!-- the plain list is centered when there is no media -->
	<view name="basic">
		<textlist name="gamelist">
			<pos>0.2 0.245</pos>
			<size>0.6 0.63</size>
			<alignment>center</alignment>
		</textlist>
		<text name="gamelistInfo">
			<pos>0.2 0.885</pos>
			<size>0.6 0.04</size>
			<alignment>center</alignment>
		</text>
	</view>
</theme>
